APP_NAME="Smart Greenhouse"
APP_ENV=local
APP_PORT=3000
APP_TIMEZONE=Asia/Jakarta

# Database MySQL (buat dulu databasenya: CREATE DATABASE smart_greenhouse;)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_greenhouse
DB_USERNAME=root
DB_PASSWORD=

# MQTT
# Broker HiveMQ publik bisa dipakai siapa saja, jadi ganti prefix dengan nama unik milikmu.
MQTT_BROKER=tcp://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-greenhouse-web
MQTT_TOPIC_PREFIX=greenhouse/ganti-nama-unik

# Data sensor disimpan ke database paling cepat tiap N detik (tampilan live tetap real-time)
SENSOR_SAVE_INTERVAL=10

# Akun login pertama (dibuat otomatis oleh seeder)
ADMIN_EMAIL=admin@greenhouse.test
ADMIN_PASSWORD=password
